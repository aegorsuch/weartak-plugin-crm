<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <permission
        android:name="com.weartak.plugin.permission.BIND_PLUGIN"
        android:protectionLevel="signature" />

    <uses-feature
        android:name="android.hardware.type.watch"
        android:required="true" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".CrmApplication"
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Crm">

        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <activity
            android:name="com.weartak.plugin.crm.presentation.CrmReserveActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="com.weartak.plugin.crm.service.WearTakPluginCrmService"
            android:exported="true"
            android:permission="com.weartak.plugin.permission.BIND_PLUGIN">
            <intent-filter>
                <action android:name="com.weartak.plugin.action.PLUGIN_SERVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <service
            android:name="com.weartak.plugin.crm.service.CrmInferenceService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
